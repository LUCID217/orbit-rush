# Copy to android/keystore.properties (git-ignored) and fill in.
# Create the upload key once with:
#   keytool -genkeypair -v -keystore orbit-rush-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# Keep the .jks and these passwords backed up somewhere safe: losing them means
# asking Google for an upload-key reset.
storeFile=../orbit-rush-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
